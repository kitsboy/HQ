{
  "name": "giveabit-hq",
  "private": true,
  "version": "3.25.0",
  "description": "Give A Bit HQ — metrics feed schema gate + lean deploy",
  "scripts": {
    "stamp": "node scripts/stamp-version.mjs",
    "verify-version": "node scripts/stamp-version.mjs",
