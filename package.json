{
  "name": "giveabit-hq",
  "private": true,
  "version": "3.30.0",
  "description": "Give A Bit HQ — rich THOR/Lightning card + freshest-metrics-wins + nightly suite metrics refresh",
  "scripts": {
    "stamp": "node scripts/stamp-version.mjs",
    "verify-version": "node scripts/stamp-version.mjs",
    "prebuild": "node scripts/stamp-version.mjs",
    "build": "node scripts/stamp-version.mjs && node scripts/build-public.mjs",
    "deploy": "npm run build && wrangler pages deploy ./public --project-name=giveabit-hq",
    "preview": "python3 -m http.server 8765 --directory public",
    "katoa-metrics": "node scripts/generate-katoa-metrics.mjs",
    "katoa-metrics-live": "node scripts/generate-katoa-metrics.mjs --live"
  },
  "devDependencies": {
    "wrangler": "^4.112.0"
  }
}
